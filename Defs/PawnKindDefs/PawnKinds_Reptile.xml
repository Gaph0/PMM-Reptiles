<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		One pawnkind per faction (user ruling 2026-09-05: scrap the multiple per-faction
		pawn types). A member's species comes entirely from the faction's xenotypeSet
		roster below; the pawnkind just supplies medieval gear and stats. Villager and
		warrior alike roll the same xenotype mix - a Dragonia knight and a Dragonia
		farmer are equally likely to be a dragon, a lizardman, a lamia, and so on.
		All faction pawns are women (mamonos are always female).
	-->
	<PawnKindDef Name="PMM_ReptilePawnBase" Abstract="True">
		<race>Human</race>
		<maxGenerationAge>60</maxGenerationAge>
		<fixedGender>Female</fixedGender>
		<chemicalAddictionChance>0.05</chemicalAddictionChance>
		<invNutrition>2.55</invNutrition>
		<invFoodDef>Pemmican</invFoodDef>
		<initialWillRange>0~4</initialWillRange>
		<initialResistanceRange>4~17</initialResistanceRange>
	</PawnKindDef>

	<!--
		The faction xenotype rosters live on the FactionDefs (Factions_Reptile.xml),
		NOT here: the game's member-xenotype tooltip and the faction pawn generator
		both read FactionDef.xenotypeSet. A pawnkind-level xenotypeSet is only a
		per-kind override and would shadow the faction roster, so these bases carry
		none.
	-->
	<PawnKindDef Name="PMM_DragoniaBase" ParentName="PMM_ReptilePawnBase" Abstract="True">
		<defaultFactionDef>PMM_DragoniaFaction</defaultFactionDef>
	</PawnKindDef>

	<PawnKindDef Name="PMM_BroodsBase" ParentName="PMM_ReptilePawnBase" Abstract="True">
		<defaultFactionDef>PMM_ScaleboundBroodsFaction</defaultFactionDef>
	</PawnKindDef>

	<!-- ===================== The single faction member kinds ===================== -->

	<PawnKindDef ParentName="PMM_DragoniaBase">
		<defName>PMM_Reptile_DragoniaMember</defName>
		<label>dragonian</label>
		<!-- factionLeader: after the collapse this is the ONLY kind in the faction's
		     pawnGroupMakers, and Faction.TryGenerateNewLeader builds its leader-kind
		     list from groupMaker options flagged factionLeader - without it the leader
		     is null. The leader is just another member. -->
		<factionLeader>true</factionLeader>
		<combatPower>55</combatPower>
		<itemQuality>Poor</itemQuality>
		<gearHealthRange>0.5~1.5</gearHealthRange>
		<apparelMoney>300~600</apparelMoney>
		<apparelTags>
			<li>Neolithic</li>
			<li>MedievalMilitary</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
		<weaponMoney>150~300</weaponMoney>
		<weaponTags>
			<li>MedievalMeleeDecent</li>
		</weaponTags>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_BroodsBase">
		<defName>PMM_Reptile_BroodMember</defName>
		<label>scalebound</label>
		<factionLeader>true</factionLeader>
		<combatPower>55</combatPower>
		<itemQuality>Poor</itemQuality>
		<gearHealthRange>0.4~1.4</gearHealthRange>
		<apparelMoney>300~600</apparelMoney>
		<apparelTags>
			<li>Neolithic</li>
			<li>MedievalMilitary</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
		<weaponMoney>120~250</weaponMoney>
		<weaponTags>
			<li>MedievalMeleeBasic</li>
		</weaponTags>
	</PawnKindDef>
	<!--
		The caravan trader (2026-09-20). Vanilla gives its caravan trader a pawnkind of
		its own (Town_Trader, Tribal_Trader): the trader flag is what the Trader pawn group
		kind looks for, and a trader is not a fighter. Gear and tags match the member kind,
		so a Dragonia caravan looks like the realm it comes from. The faction's Trader group
		maker (Factions_Reptile.xml) is what uses this kind.
	-->
	<PawnKindDef ParentName="PMM_DragoniaBase">
		<defName>PMM_Reptile_DragoniaTrader</defName>
		<label>dragonian trader</label>
		<trader>true</trader>
		<isFighter>false</isFighter>
		<combatPower>45</combatPower>
		<itemQuality>Poor</itemQuality>
		<gearHealthRange>0.5~1.5</gearHealthRange>
		<apparelMoney>300~600</apparelMoney>
		<apparelTags>
			<li>Neolithic</li>
			<li>MedievalMilitary</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
		<weaponMoney>150~300</weaponMoney>
		<weaponTags>
			<li>MedievalMeleeDecent</li>
		</weaponTags>
	</PawnKindDef>

</Defs>
