<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		One pawnkind per faction (user ruling 2026-09-05: scrap the multiple per-faction
		pawn types). A member's species comes entirely from the faction's xenotypeSet
		roster below; the pawnkind just supplies medieval gear and stats. Villager and
		warrior alike roll the same xenotype mix — a Dragonia knight and a Dragonia
		farmer are equally likely to be a dragon, a lizardman, a lamia, and so on.
		All faction pawns are women (momos are always female).
	-->
	<PawnKindDef Name="PMM_ReptilePawnBase" Abstract="True">
		<race>Human</race>
		<maxGenerationAge>60</maxGenerationAge>
		<fixedGender>Female</fixedGender>
		<chemicalAddictionChance>0.05</chemicalAddictionChance>
		<invNutrition>2.55</invNutrition>
		<invFoodDef>Pemmican</invFoodDef>
		<initialWillRange>0~4</initialWillRange>
		<initialResistanceRange>4~17</initialResistanceRange>
	</PawnKindDef>

	<!--
		Dragonia roster (locked): Dragon + Lizardman exclusive; plus the shared
		Lamia, Basilisk, Medusa, Wurm, Wyvern. Weights sum to 100.
	-->
	<PawnKindDef Name="PMM_DragoniaBase" ParentName="PMM_ReptilePawnBase" Abstract="True">
		<defaultFactionDef>PMM_DragoniaFaction</defaultFactionDef>
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Lizardman>25</PMM_Lizardman>
				<PMM_Wyvern>20</PMM_Wyvern>
				<PMM_Lamia>20</PMM_Lamia>
				<PMM_Basilisk>15</PMM_Basilisk>
				<PMM_Wurm>12</PMM_Wurm>
				<PMM_Dragon>6</PMM_Dragon>
				<PMM_Medusa>2</PMM_Medusa>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>

	<!--
		Scalebound Broods roster (locked): Malef Dragon, Dragonewt, Salamander
		exclusive; plus the shared Lamia, Basilisk, Medusa, Wurm. Weights sum to 100.
	-->
	<PawnKindDef Name="PMM_BroodsBase" ParentName="PMM_ReptilePawnBase" Abstract="True">
		<defaultFactionDef>PMM_ScaleboundBroodsFaction</defaultFactionDef>
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Lamia>28</PMM_Lamia>
				<PMM_Basilisk>20</PMM_Basilisk>
				<PMM_Dragonewt>18</PMM_Dragonewt>
				<PMM_Salamander>15</PMM_Salamander>
				<PMM_Wurm>10</PMM_Wurm>
				<PMM_Medusa>5</PMM_Medusa>
				<PMM_MalefDragon>4</PMM_MalefDragon>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>

	<!-- ===================== The single faction member kinds ===================== -->

	<PawnKindDef ParentName="PMM_DragoniaBase">
		<defName>PMM_DragoniaMember</defName>
		<label>dragonian</label>
		<combatPower>55</combatPower>
		<itemQuality>Poor</itemQuality>
		<gearHealthRange>0.5~1.5</gearHealthRange>
		<apparelMoney>300~600</apparelMoney>
		<apparelTags>
			<li>Neolithic</li>
			<li>MedievalMilitary</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
		<weaponMoney>150~300</weaponMoney>
		<weaponTags>
			<li>MedievalMeleeDecent</li>
		</weaponTags>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_BroodsBase">
		<defName>PMM_BroodMember</defName>
		<label>scalebound</label>
		<combatPower>55</combatPower>
		<itemQuality>Poor</itemQuality>
		<gearHealthRange>0.4~1.4</gearHealthRange>
		<apparelMoney>300~600</apparelMoney>
		<apparelTags>
			<li>Neolithic</li>
			<li>MedievalMilitary</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
		<weaponMoney>120~250</weaponMoney>
		<weaponTags>
			<li>MedievalMeleeBasic</li>
		</weaponTags>
	</PawnKindDef>

</Defs>
