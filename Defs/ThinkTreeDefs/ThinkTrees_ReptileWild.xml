<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Give the wild reptile pawn kinds the same wild-man behaviour as vanilla WildMan.
		The vanilla Humanlike think tree only applies MainWildManBehaviorCore + the idle
		wander to pawnKind=WildMan (ThinkNode_ConditionalPawnKind), so a wild reptile
		would otherwise fall through to the guest branch and immediately
		JobGiver_ExitMapBest off the map — the pawn spawns (the wander-in letter fires)
		and walks straight to the edge before the player ever sees her. This was the
		missing piece behind "wild momo wander-ins don't work": the incident, the gates,
		and the spawn all worked; the pawn just left the map on her first think tick.
		These subtrees are inserted via the Humanlike_PostMain insertTag, mirroring the
		vanilla wild-man branches (the slime mod's ThinkTrees_Slime.xml pattern, which
		the reptile port had missed).

		Every wild reptile kind must be listed or it will walk straight off the map:
		PMM_WildBasilisk / Dragon / Lamia / Lizardman / Medusa / Wurm / Wyvern /
		Salamander / Bunyip. (Malef Dragon and Dragonewt are not wild — faction-only.)
	-->
	<ThinkTreeDef>
		<defName>PMM_ReptileWildBehavior</defName>
		<insertTag>Humanlike_PostMain</insertTag>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildBasilisk</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildDragon</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildLamia</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildLizardman</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildMedusa</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildWurm</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildWyvern</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildSalamander</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildBunyip</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

	<!-- The idle wander branch (what the wild man does between threats): same
	     JobGiver_WanderAnywhere the vanilla WildMan idle subtree uses. -->
	<ThinkTreeDef>
		<defName>PMM_ReptileWildIdle</defName>
		<insertTag>Humanlike_PostMain</insertTag>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildBasilisk</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
