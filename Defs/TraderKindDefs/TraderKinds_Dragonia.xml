<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Dragonian traders (2026-09-20). Two kinds, wired to Dragonia only:
		the Scalebound Broods are permanent enemies and never send anyone.

		Shape follows vanilla Caravan_Neolithic_BulkGoods - a medieval-tech
		faction's bulk trader: resources and food, drugs, melee weapons, clothing,
		pack animals, then the vanilla buying generators. The stock is themed on
		the realm: her own people's shed scales are the signature textile, jade
		because her holds sit in mountains, plus herbal medicine, pemmican and
		silver. Every gate is maxTechLevelGenerate Medieval (the faction's tech
		level), so nothing modern turns up in a mountain market.

		Deliberately NOT sold:
		- reptile eggs. The only egg the mod ships is PMM_ReptileEggFertilized, a
		  baby momo; vanilla traders exclude fertilized eggs from their food stock
		  for the same reason, and selling one would hand the player a free girl.
		- PMM_DarkDragonsBlood. That blood comes from malef dragons, who exist only
		  among the hostile Broods, so it stays raid loot and a harvest recipe.

		Dragon scales are the priciest line here (the thrumbo-tier scale material),
		so they arrive in the smallest counts.
	-->
	<TraderKindDef>
		<defName>PMM_DragoniaTrader</defName>
		<label>dragonian trader</label>
		<stockGenerators>

			<!-- Money -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>600~1100</countRange>
			</li>

			<!-- Food and medicine -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>Pemmican</thingDef>
				<countRange>150~300</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineHerbal</thingDef>
				<countRange>5~45</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>FoodRaw</categoryDef>
				<thingDefCountRange>3~3</thingDefCountRange>
				<totalPriceRange>300~500</totalPriceRange>
				<excludedCategories>
					<li>EggsFertilized</li>
				</excludedCategories>
			</li>

			<!-- Mountain wealth -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>Jade</thingDef>
				<countRange>80~350</countRange>
			</li>

			<!-- Dragon orbs (2026-09-22): the realm's own craft, and the caravan
			     trader's alone - the visitor kind below carries none, the same way
			     vanilla visitor traders carry no plasteel. One calling orb at a time,
			     because it is an expensive thing and because an orb that has called a
			     dragon is no longer a calling orb; the glowing orbs are cheap enough
			     to arrive in pairs. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_DragonOrb</thingDef>
				<countRange>1~1</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_DragonOrbDecor</thingDef>
				<countRange>1~2</countRange>
			</li>

			<!-- Wedding collars (2026-09-23): Dragonia's jewellers, one or two at a time.
			     The wiki prices one at a dragoon's first month of pay, and the caravan
			     trader is the only one who has them - the visitor kind carries none. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_WeddingCollar</thingDef>
				<countRange>1~2</countRange>
			</li>

			<!-- The realm's own metal (2026-09-22), at plasteel's own rate: vanilla's
			     neolithic shaman-merchant and outlander bulk trader both carry 50~150
			     plasteel, and 50~150 is what this is. It appears in no other trader's
			     stock, because it lives in a thing category no generator rolls (see
			     Defs/ThingDefs/Item_Dragonium.xml). The visitor kind below carries none,
			     exactly as vanilla visitor traders carry no plasteel. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Dragonium</thingDef>
				<countRange>50~150</countRange>
			</li>

			<!-- Shed scales: one line per scale material the realm fields (three since
			     2026-09-22, with the ranges covering every species that sheds each).
			     No bunyip wool: the bunyip is a wild creature, not a realm subject, so
			     her wool is butcher and shed loot only. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Lizardman</thingDef>
				<countRange>60~180</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Lamia</thingDef>
				<countRange>50~150</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Dragon</thingDef>
				<countRange>8~25</countRange>
			</li>

			<!-- Drugs, medieval ceiling -->
			<li Class="StockGenerator_Category">
				<categoryDef>Drugs</categoryDef>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>

			<!-- The realm's own vintage (2026-09-22). An explicit line on top of the
			     category roll above, which only might have offered it: every dragonian
			     caravan carries a crate of Dragon's Lifeblood, the wine the Queen's
			     dragoons drink. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_DragonsLifeblood</thingDef>
				<countRange>15~40</countRange>
			</li>

			<!-- Weapons: melee only, this is a medieval realm -->
			<li Class="StockGenerator_Category">
				<categoryDef>WeaponsMelee</categoryDef>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
				<thingDefCountRange>3~3</thingDefCountRange>
				<countRange>1~1</countRange>
			</li>

			<!-- Clothing -->
			<li Class="StockGenerator_MarketValue">
				<tradeTag>BasicClothing</tradeTag>
				<countRange>6~6</countRange>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>
			<li Class="StockGenerator_MarketValue">
				<tradeTag>Clothing</tradeTag>
				<countRange>3~3</countRange>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>

			<!-- Pack and farm animals, sold as a mating pair where vanilla does -->
			<li Class="StockGenerator_Animals">
				<maxWildness>0.70</maxWildness>
				<tradeTagsSell>
					<li>AnimalFarm</li>
				</tradeTagsSell>
				<kindCountRange>2~2</kindCountRange>
				<countRange>3~4</countRange>
				<createMatingPair>
					<li>AnimalFarm</li>
				</createMatingPair>
			</li>

			<!-- Buying: the realm wants silver's worth of goods, art above all -
			     dragons are hoard-keepers. -->
			<li Class="StockGenerator_BuyExpensiveSimple" />
			<li Class="StockGenerator_BuyTradeTag">
				<tag>Art</tag>
			</li>
			<li Class="StockGenerator_BuyTradeTag">
				<tag>ResourcesRaw</tag>
			</li>

		</stockGenerators>
	</TraderKindDef>

	<!--
		Dragonian visiting trader (2026-09-20). Vanilla keeps visitor traders separate
		from caravan traders (Visitor_Neolithic_Standard vs Caravan_Neolithic_*): a
		visitor trader carries her whole stock in her own inventory and walks in with a
		visitor group, while a caravan trader is loaded onto pack animals. So this is a
		smaller version of the caravan kind - the same themed goods at lower counts, and
		no animals. The faction's <visitorTraderKinds> wires it up, and
		IncidentWorker_VisitorGroup.TryConvertOnePawnToSmallTrader gives it to one
		random adult of a visiting group.
	-->
	<TraderKindDef>
		<defName>PMM_DragoniaVisitor</defName>
		<label>dragonian trader</label>
		<stockGenerators>

			<!-- Money -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>250~600</countRange>
			</li>

			<!-- Food and medicine -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>Pemmican</thingDef>
				<countRange>60~150</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineHerbal</thingDef>
				<countRange>5~20</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Jade</thingDef>
				<countRange>30~150</countRange>
			</li>

			<!-- Scales: the signature line, all three scale materials, so one woman can
			     carry them all. No bunyip wool - that one is a wild creature's. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Lizardman</thingDef>
				<countRange>20~60</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Lamia</thingDef>
				<countRange>15~50</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_Scale_Dragon</thingDef>
				<countRange>2~10</countRange>
			</li>

			<!-- Drugs, medieval ceiling (same gate as the caravan kind) -->
			<li Class="StockGenerator_Category">
				<categoryDef>Drugs</categoryDef>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>

			<!-- The realm's own vintage (2026-09-22): a few flasks in her pack, the
			     same wine the caravan kind carries by the crate. -->
			<li Class="StockGenerator_SingleDef">
				<thingDef>PMM_DragonsLifeblood</thingDef>
				<countRange>5~15</countRange>
			</li>

			<!-- Weapons: melee only, this is a medieval realm -->
			<li Class="StockGenerator_Category">
				<categoryDef>WeaponsMelee</categoryDef>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
				<thingDefCountRange>1~2</thingDefCountRange>
				<countRange>1~1</countRange>
			</li>

			<!-- Clothing -->
			<li Class="StockGenerator_MarketValue">
				<tradeTag>BasicClothing</tradeTag>
				<countRange>3~3</countRange>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>
			<li Class="StockGenerator_MarketValue">
				<tradeTag>Clothing</tradeTag>
				<countRange>1~1</countRange>
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
			</li>

			<!-- Buying: art above all, as in the caravan kind -->
			<li Class="StockGenerator_BuyExpensiveSimple" />
			<li Class="StockGenerator_BuyTradeTag">
				<tag>Art</tag>
			</li>

		</stockGenerators>
	</TraderKindDef>

</Defs>
