<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Shared base for both reptile momo factions. Medieval tech (locked ruling),
		tribal backstories (the closest vanilla pool to medieval mountain-folk),
		tribal raid loot. The mountain-only settlement placement is NOT expressible
		in XML: PMM_Reptiles.Patch_RandomSettlementTileFor enforces it in C#.
		With the core mod's DisableVisibleFactions patch removing all vanilla
		factions, these two are the only world factions, so the counts stay modest:
		Dragonia 4 settlements, the Broods 3.
	-->
	<FactionDef ParentName="FactionBase" Name="PMM_ReptileFactionBase" Abstract="True">
		<categoryTag>Reptile</categoryTag>
		<listOrderPriority>25</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<techLevel>Medieval</techLevel>
		<maxConfigurableAtWorldCreation>10</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>25</configurationListOrderPriority>
		<allowedCultures>
			<li>Corunan</li>
		</allowedCultures>
		<backstoryFilters>
			<li>
				<categories>
					<li>Tribal</li>
				</categories>
			</li>
		</backstoryFilters>
		<raidLootMaker>TribeRaidLootMaker</raidLootMaker>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
	</FactionDef>

	<!--
		Dragonia, the neutral faction (locked ruling). A mountain realm where dragons
		and humans coexist: not a natural enemy, not a siege faction, no forced memes -
		its ideoligions roll freely. Can be befriended, traded with, and offended.
	-->
	<FactionDef ParentName="PMM_ReptileFactionBase">
		<defName>PMM_DragoniaFaction</defName>
		<label>Dragonia</label>
		<description>A great mountain realm where dragons and humans coexist. The dragonians keep to their high valleys and natural fortresses, trading tales of their lady-knights and the great wyrms they answer to. They want no quarrel with outsiders - but their peaks are not defenceless.</description>
		<pawnSingular>dragonian</pawnSingular>
		<pawnsPlural>dragonians</pawnsPlural>
		<leaderTitle>dragon lady</leaderTitle>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<!-- startingCountAtWorldCreation is the number of FACTION INSTANCES the
		     world-creator pre-adds (each gets its own name and settlements) - NOT
		     settlements. 4 here produced four duplicate Dragonias. One realm only. -->
		<startingCountAtWorldCreation>1</startingCountAtWorldCreation>
		<factionIconPath>World/WorldObjects/Expanding/PMM_DragoniaHold</factionIconPath>
		<!-- settlementTexturePath (NOT factionIconPath) is what Settlement.Material
		     draws on the world map; leaving it unset throws ArgumentNullException
		     on every settlement draw. factionIconPath is only the world-creation
		     UI icon. Vanilla sets both. -->
		<settlementTexturePath>World/WorldObjects/Expanding/PMM_DragoniaHold</settlementTexturePath>
		<factionNameMaker>PMM_NamerFactionDragonia</factionNameMaker>
		<settlementNameMaker>PMM_NamerSettlementDragonia</settlementNameMaker>
		<!-- Member xenotype roster (locked): Dragon + Lizardman exclusive; plus the
		     shared Lamia, Basilisk, Medusa, Wurm, Wyvern. FRACTIONS (the outlander
		     pattern) - Baseliner gets whatever is left over (~0, since they sum to 1).
		     This is what the member-xenotype tooltip and the faction pawn generator read. -->
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Reptile_Lizardman>0.25</PMM_Reptile_Lizardman>
				<PMM_Reptile_Wyvern>0.20</PMM_Reptile_Wyvern>
				<PMM_Reptile_Lamia>0.20</PMM_Reptile_Lamia>
				<PMM_Reptile_Basilisk>0.15</PMM_Reptile_Basilisk>
				<PMM_Reptile_Wurm>0.12</PMM_Reptile_Wurm>
				<PMM_Reptile_Dragon>0.06</PMM_Reptile_Dragon>
				<PMM_Reptile_Medusa>0.02</PMM_Reptile_Medusa>
			</xenotypeChances>
		</xenotypeSet>
		<colorSpectrum>
			<li>(0.45, 0.65, 0.25)</li>
			<li>(0.85, 0.75, 0.35)</li>
		</colorSpectrum>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<options>
					<PMM_Reptile_DragoniaMember>10</PMM_Reptile_DragoniaMember>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<PMM_Reptile_DragoniaMember>10</PMM_Reptile_DragoniaMember>
				</options>
			</li>
			<!--
				Trader caravans (added 2026-09-20). Listing a caravanTraderKind is not enough:
				without a Trader group maker the faction cannot build the caravan at all, and
				the game logs "has no usable PawnGroupMakers for ... groupKind=Trader".
				The trader is its own pawnkind (the vanilla Town_Trader pattern: the trader
				flag, and not a fighter); the member kind forms the caravan guard. Weights
				are relative, like vanilla's; the pack animals are the vanilla tribal set.
			-->
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<PMM_Reptile_DragoniaTrader>1</PMM_Reptile_DragoniaTrader>
				</traders>
				<carriers>
					<Muffalo>6</Muffalo>
					<Dromedary>5</Dromedary>
					<Alpaca>2.5</Alpaca>
					<Elephant>2</Elephant>
				</carriers>
				<guards>
					<PMM_Reptile_DragoniaMember>10</PMM_Reptile_DragoniaMember>
				</guards>
			</li>
		</pawnGroupMakers>
		<!-- Trader caravans (added 2026-09-20). Only the neutral realm trades: the
		     Broods are permanent enemies and never send anyone. The kind itself is
		     Defs/TraderKindDefs/TraderKinds_Dragonia.xml. -->
		<caravanTraderKinds>
			<li>PMM_DragoniaTrader</li>
		</caravanTraderKinds>
		<!-- Visiting traders (2026-09-20). Vanilla's visitor-group incident
		     (IncidentWorker_VisitorGroup) turns one random adult visitor into a small
		     trader 75% of the time - but only for a faction that lists visitor trader
		     kinds, so without this list dragonian visitors never trade and only
		     dragonian caravans do. The kind is the smaller visitor variant in
		     Defs/TraderKindDefs/TraderKinds_Dragonia.xml. -->
		<visitorTraderKinds>
			<li>PMM_DragoniaVisitor</li>
		</visitorTraderKinds>
		<!-- Base trading (added 2026-09-22): a player caravan that reaches a Dragonian
		     town can trade there. The Broods are permanent enemies and stay untradeable.
		     Settlement_TraderTracker reads this list live off the faction def, so this
		     also fixes existing saves. The kind is the larger caravan variant in
		     Defs/TraderKindDefs/TraderKinds_Dragonia.xml. -->
		<baseTraderKinds>
			<li>PMM_DragoniaTrader</li>
		</baseTraderKinds>
	</FactionDef>

	<!--
		The Scalebound Broods, the hostile lewdist faction (locked rulings):
		permanent enemy, sieges and staged attacks, and EVERY brood ideoligion is
		forced to include the Monster Extremists meme - and no other required meme -
		via requiredMemes (the vanilla OutlanderRoughBase/Supremacist pattern; the
		meme is a Misc-group meme, not a structure meme, so structureMemeWeights
		would not apply).
	-->
	<FactionDef ParentName="PMM_ReptileFactionBase">
		<defName>PMM_ScaleboundBroodsFaction</defName>
		<label>Scalebound broods</label>
		<description>Lewdist sisterhoods of the high peaks, driven by a monstrous creed: the baseline human form is a larval state, unworthy of respect. Their raiders descend from the mountains to claim men and remake women - and their lamia coil-sisters delight in the catching.</description>
		<pawnSingular>scalebound</pawnSingular>
		<pawnsPlural>scalebound</pawnsPlural>
		<leaderTitle>brood matriarch</leaderTitle>
		<permanentEnemy>true</permanentEnemy>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<startingCountAtWorldCreation>1</startingCountAtWorldCreation>
		<factionIconPath>World/WorldObjects/Expanding/PMM_BroodNest</factionIconPath>
		<settlementTexturePath>World/WorldObjects/Expanding/PMM_BroodNest</settlementTexturePath>
		<factionNameMaker>PMM_NamerFactionBroods</factionNameMaker>
		<settlementNameMaker>PMM_NamerSettlementBroods</settlementNameMaker>
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">ProjectMomo_Meme_MonsterExtremists</li>
		</requiredMemes>
		<!-- Member xenotype roster (locked): Malef Dragon, Dragonewt, Salamander
		     exclusive; plus the shared Lamia, Basilisk, Medusa, Wurm. FRACTIONS. -->
		<xenotypeSet>
			<xenotypeChances>
				<PMM_Reptile_Lamia>0.28</PMM_Reptile_Lamia>
				<PMM_Reptile_Basilisk>0.20</PMM_Reptile_Basilisk>
				<PMM_Reptile_Dragonewt>0.18</PMM_Reptile_Dragonewt>
				<PMM_Reptile_Salamander>0.15</PMM_Reptile_Salamander>
				<PMM_Reptile_Wurm>0.10</PMM_Reptile_Wurm>
				<PMM_Reptile_Medusa>0.05</PMM_Reptile_Medusa>
				<PMM_Reptile_MalefDragon>0.04</PMM_Reptile_MalefDragon>
			</xenotypeChances>
		</xenotypeSet>
		<colorSpectrum>
			<li>(0.65, 0.1, 0.2)</li>
			<li>(0.85, 0.45, 0.6)</li>
		</colorSpectrum>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<options>
					<PMM_Reptile_BroodMember>10</PMM_Reptile_BroodMember>
				</options>
			</li>
		</pawnGroupMakers>
		<!-- Broods loot: dark dragon's blood turns up in their raids and on their
		     settlements (they harvest it from their own malef dragons), and with it
		     the dragonian wine they drink. See PMM_BroodsRaidLootMaker. -->
		<raidLootMaker>PMM_BroodsRaidLootMaker</raidLootMaker>
		<settlementLootMaker>PMM_BroodsRaidLootMaker</settlementLootMaker>
	</FactionDef>

	<!--
		Broods raid/settlement loot: mostly the usual silver and supplies a
		medieval raider carries, with a chance of a vial of dark dragon's blood
		(their signature) and of the dragonian wine they drink. Count-based so a
		vial is a discrete find, not a value share; the blood is the draw, the
		silver is filler.

		The wine is here because the Broods cannot trade: they are permanent
		enemies, and the game never sends traders from a permanent enemy, so a
		raider's pack and a captured camp are how this side of the world's share of
		Dragon's Lifeblood reaches the player. It is the common find of the two - a
		crate of flasks against a single vial of blood.
	-->
	<ThingSetMakerDef>
		<defName>PMM_BroodsRaidLootMaker</defName>
		<root Class="ThingSetMaker_Sum">
			<options>
				<li>
					<chance>0.5</chance>
					<thingSetMaker Class="ThingSetMaker_Count">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>PMM_DarkDragonsBlood</li>
								</thingDefs>
							</filter>
							<countRange>1~2</countRange>
						</fixedParams>
					</thingSetMaker>
				</li>
				<li>
					<chance>0.7</chance>
					<thingSetMaker Class="ThingSetMaker_Count">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>PMM_DragonsLifeblood</li>
								</thingDefs>
							</filter>
							<countRange>2~6</countRange>
						</fixedParams>
					</thingSetMaker>
				</li>
				<li>
					<chance>1.0</chance>
					<thingSetMaker Class="ThingSetMaker_MarketValue">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>Silver</li>
								</thingDefs>
							</filter>
						</fixedParams>
					</thingSetMaker>
				</li>
			</options>
		</root>
	</ThingSetMakerDef>

</Defs>
