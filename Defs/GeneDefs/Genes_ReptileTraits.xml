<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Forced-trait genes for the reptile xenotypes, the Biotech KindInstinct pattern:
		a gene that carries <forcedTraits>, so the personality is germline (wild and
		colony reptiles share it) rather than a faction-only pawnkind flag. Each is
		endogenes-only and out of the tradeable pool (canGenerateInGeneSet false).
		Trait defNames verified against Core Traits_Singular/Traits_Spectrum.
	-->

	<!-- Dragon: arrogant and greedy, hoard-keeper pride. -->
	<GeneDef>
		<defName>PMM_GeneTrait_DragonPride</defName>
		<label>dragon's pride</label>
		<labelShortAdj>proud</labelShortAdj>
		<description>Carriers of this gene are haughty and acquisitive - every one of them a hoard-keeper convinced of her own magnificence.</description>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<forcedTraits>
			<li><def>Jealous</def></li>
			<li><def>Greedy</def></li>
		</forcedTraits>
	</GeneDef>

	<!-- Wurm: powerful and very stupid. SlowLearner (degree 0) is the vanilla
	     "stupid" trait - TooSmart has only degree 0 (a smart trait), so the earlier
	     TooSmart/-1 forced degree logged "found no data at degree -1" spam. -->
	<GeneDef>
		<defName>PMM_GeneTrait_WurmMind</defName>
		<label>wurm's mind</label>
		<labelShortAdj>dull</labelShortAdj>
		<description>Carriers of this gene are slow of thought - all muscle and appetite, with little room left for thinking.</description>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<forcedTraits>
			<li><def>SlowLearner</def></li>
		</forcedTraits>
	</GeneDef>

	<!--
		Scrapped (user ruling 2026-09-05): PMM_GeneTrait_LizardmanFury,
		PMM_GeneTrait_Lustful, PMM_GeneTrait_BunyipTongue. Lizardmen, salamanders,
		malef dragons, dragonewts and bunyips no longer carry a forced-personality
		gene; their flavour lives in the xenotype descriptions.
	-->

</Defs>
