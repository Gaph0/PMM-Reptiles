<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Phase 2 genes. PMM_Gene_Petrify is live (PetrifyPowers.cs: PMM_Ability_Petrify
		+ PMM_Hediff_Petrified + the Need.IsFrozen stasis patch).
		PMM_Gene_MalefCorruption has no mechanic of its own: it is the marker a malef
		dragon carries, which the blood harvest and the dark blood itself look for.
	-->

	<!-- Medusa: petrifying gaze. Grants PMM_Ability_Petrify (the Dorome mud-merge
	     pattern: the vanilla ability system runs the gizmo and cooldown). -->
	<GeneDef>
		<defName>PMM_Gene_Petrify</defName>
		<label>petrifying gaze</label>
		<labelShortAdj>petrifying</labelShortAdj>
		<description>Carriers of this gene can freeze a victim solid with a look - alive but motionless, hunger and weariness held in perfect stasis, until the spell loosens days later.</description>
		<iconPath>UI/Icons/Genes/PMM_Gene_Petrify</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>2</biostatCpx>
		<biostatMet>1</biostatMet>
		<abilities>
			<li>PMM_Ability_Petrify</li>
		</abilities>
		<customEffectDescriptions>
			<li>Can petrify a victim with her gaze: the target is frozen - downed and unchanging - for two days.</li>
		</customEffectDescriptions>
	</GeneDef>

	<!-- Malef Dragon: the dark blood marker. There is no tease mechanic any more
	     (scrapped 2026-09-05: the knockout and the colony offer are both gone).
	     This gene marks a malef for the surgery that draws her blood
	     (Source/Reptiles/BloodHarvest.cs), and PMM_DarkDragonsBlood does the
	     remaking (Source/Reptiles/DarkDragonsBlood.cs): a dragonewt on the first
	     drink, a malef dragon on the second. -->
	<GeneDef>
		<defName>PMM_Gene_MalefCorruption</defName>
		<label>malef corruption</label>
		<labelShortAdj>corrupting</labelShortAdj>
		<description>Her blood carries the corruption. A vial drawn from her turns an ordinary woman into a dragonewt, and a dragonewt who drinks a second vial becomes a malef dragon.</description>
		<iconPath>UI/Icons/Genes/PMM_Gene_MalefCorruption</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>2</biostatCpx>
		<biostatMet>1</biostatMet>
		<!-- Rewritten 2026-09-23: the old text promised women being transformed by broken
		     will, which is the scrapped teasing mechanic and never happens in play. This now
		     describes what the game actually does - the blood - so a player reading it is not
		     sent looking for a power that does not exist. The lore wording is the user's. -->
		<customEffectDescriptions>
			<li>Dark dragon's blood is drawn from her. Drinking a vial turns an ordinary woman into a dragonewt, and a second vial turns a dragonewt into a malef dragon.</li>
		</customEffectDescriptions>
	</GeneDef>

</Defs>
