<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Reptile skin materials, four of them (2026-09-22, user call: the item pool had
		one material per species). Every reptile momo now sheds one of these four, so a
		corpse's material is easy to read at a glance and the list stays short. Bunyip
		wool is deliberately kept on its own: the bunyip is a special kind of reptile
		(user ruling 2026-09-22), so her wool stays a separate, wool-category material
		instead of being folded into the serpent-kin scales.

		Mapping, following the stat-sharing rulings this file used to carry:
		- dragon scales:    dragon, malef dragon, dragonewt, wyvern
		- lamia scales:     lamia, medusa, wurm
		- lizardman scales: lizardman, basilisk, salamander
		- bunyip wool:      bunyip (wild-only, and the only wool in the family)

		Stats (2026-09-06, user spreadsheet "leather chart.ods"). Interpretation:
		- armour sharp/blunt/heat columns are FACTORS on the LeatherBase values
		  sharp 0.81 and heat 1.5; the BLUNT factor applies to the SHARP base (0.81)
		  - every blunt factor <= its sharp factor, and f0.4 -> 0.32 lands just under
		  thrumbofur (0.36) where premium scales belong. Bunyip wool's heat armour is
		  the one exception, set to vanilla wool's own value instead (see its comment).
		- insulation columns are ABSOLUTE C (StuffPower_Insulation is a C offset;
		  as factors they would give absurd 200-480C values).
		- max HP and beauty are stuffProps statFACTORS (crafted-item multipliers,
		  the thrumbofur pattern); value is a factor on LeatherBase's $2.1.

		The abstract base carries only the neutral ResourceBase stats; every material
		below sets its full stat block explicitly, so the factors stay readable next
		to the numbers they produced.
	-->

	<ThingDef Abstract="True" Name="PMM_ReptileScaleSpeciesBase" ParentName="ResourceBase">
		<thingCategories>
			<li>Leathers</li>
		</thingCategories>
		<stackLimit>75</stackLimit>
		<graphicData>
			<texPath>Things/Item/Resource/PMM_ReptileScale</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.03</Mass>
		</statBases>
		<stuffProps>
			<categories>
				<li>Leathery</li>
			</categories>
			<commonality>0.07</commonality>
			<color>(126,148,84)</color>
		</stuffProps>
	</ThingDef>

	<!-- Dragon scales (f2 HP/sharp, f0.4 blunt, f0.8 heat, f1.25 cold, f1.5 heat-ins,
		f6 beauty, f8 value) - the thrumbo-tier trophy leather. Also shed by every
		dragon-kin: malef dragons, wyverns and dragonewts. -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Dragon</defName>
		<label>dragon scales</label>
		<description>Scales shed by a dragon or her kin. Rich, hard, and faintly warm to the touch.</description>
		<statBases>
			<MarketValue>16.8</MarketValue>
			<StuffPower_Armor_Sharp>1.62</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.32</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>2.25</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>20</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>25</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps><color>(168,80,50)</color>
			<statFactors>
				<MaxHitPoints>2.0</MaxHitPoints>
				<Beauty>6</Beauty>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Lamia scales (f1 HP, f1 sharp, f0.14 blunt, f0.14 heat, f1 cold, f1.25 heat-ins,
		f1.7 beauty, f3 value) - plain-leather tier with prettier finished goods. Also
		shed by the rest of the serpent kin: medusas and wurms. -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Lamia</defName>
		<label>lamia scales</label>
		<description>Scales shed by a lamia or her serpent kin. Smooth, flexible, and finely patterned.</description>
		<statBases>
			<MarketValue>6.3</MarketValue>
			<StuffPower_Armor_Sharp>0.89</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.11</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>1.5</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>15</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>20</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps><color>(150,140,90)</color>
			<statFactors>
				<MaxHitPoints>1.0</MaxHitPoints>
				<Beauty>1.7</Beauty>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Lizardman scales (f1.3 sharp / f0.14 blunt / f0.2 heat / f1 cold / f0.9 heat-ins /
		f1.5 value). Also shed by basilisks and salamanders. -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Lizardman</defName>
		<label>lizardman scales</label>
		<description>Scales shed by a lizardman or her kin. Tough and matte, a warrior's hide.</description>
		<statBases>
			<MarketValue>3.15</MarketValue>
			<StuffPower_Armor_Sharp>1.05</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.11</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>1.5</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>15</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>18</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps><color>(100,130,70)</color>
			<statFactors>
				<MaxHitPoints>1.3</MaxHitPoints>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Bunyip wool: a WOOL, not a scale, and the bunyip's alone (user ruling
		2026-09-22: the bunyip is a special kind of reptile, so her material stays its
		own). It carries the Wools thing category on top of the base's Leathers, and its
		stuff category is Fabric, so tailor benches and leatherworking benches both take
		it. 1.7 flammability (the sheep-wool value) - it burns easily. Sharp and blunt
		armour are factors on the leather bases (f1.2 sharp / f0.2 blunt). The heat
		armour is NOT a factor: it is vanilla wool's own 1.10 (110%), user call
		2026-09-22, because the chart's f2 gave 3.0 - exactly devilstrand, the game's
		heat-proof textile - on a wool that catches fire. Insulation is wool-tier (30C
		cold / 18C heat), f1.2 HP, f8 beauty, f8 value. -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Bunyip</defName>
		<label>bunyip wool</label>
		<description>Coarse, water-shedding wool shorn from a bunyip's pelt. Warm, tough, and catches flame worryingly easily.</description>
		<thingCategories>
			<li>Wools</li>
		</thingCategories>
		<statBases>
			<MarketValue>16.8</MarketValue>
			<Flammability>1.7</Flammability>
			<StuffPower_Armor_Sharp>0.97</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.16</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>1.10</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>30</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>18</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps>
			<categories>
				<li>Fabric</li>
			</categories>
			<color>(90,120,90)</color>
			<statFactors>
				<MaxHitPoints>1.2</MaxHitPoints>
				<Beauty>8</Beauty>
			</statFactors>
		</stuffProps>
	</ThingDef>

</Defs>
