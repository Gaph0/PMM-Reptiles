		<label>salamander scales</label>
		<description>Scales shed by a salamander. Ember-bright and heat-hardened.</description>
		<statBases>
			<MarketValue>10.5</MarketValue>
			<StuffPower_Armor_Sharp>1.05</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.16</StuffPower_Armor_Blunt>
