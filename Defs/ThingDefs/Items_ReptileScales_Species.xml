<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Per-species scale materials (locked Q5): each reptile xenotype sheds its own
		scales. All reuse the single generic PMM_ReptileScale texture for now (later art
		pass); only label, description, colour tint and minor stat flavour differ.
		Shared base carries the Leathery stuffProps category so every recipe that takes
		leather/wool accepts them. The shedding hediff maps xenotype → material in C#
		(next step); until then all reptiles drop the generic PMM_ReptileScale.
	-->

	<ThingDef Abstract="True" Name="PMM_ReptileScaleSpeciesBase" ParentName="ResourceBase">
		<thingCategories>
			<li>Leathers</li>
		</thingCategories>
		<stackLimit>75</stackLimit>
		<graphicData>
			<texPath>Things/Item/Resource/PMM_ReptileScale</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.03</Mass>
			<MarketValue>3.5</MarketValue>
			<StuffPower_Armor_Sharp>1.1</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.3</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.8</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>8</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>14</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps>
			<categories>
				<li>Leathery</li>
			</categories>
			<commonality>0.07</commonality>
			<color>(126,148,84)</color>
		</stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Basilisk</defName>
		<label>basilisk scales</label>
		<description>Scales shed by a basilisk. Supple and keen-edged, workable like leather.</description>
		<stuffProps><color>(110,150,90)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Dragon</defName>
		<label>dragon scales</label>
		<description>Scales shed by a dragon. Rich, hard, and faintly warm to the touch.</description>
		<stuffProps><color>(168,80,50)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Lamia</defName>
		<label>lamia scales</label>
		<description>Scales shed by a lamia. Smooth, flexible, and finely patterned.</description>
		<stuffProps><color>(150,140,90)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Lizardman</defName>
		<label>lizardman scales</label>
		<description>Scales shed by a lizardman. Tough and matte, a warrior's hide.</description>
		<stuffProps><color>(100,130,70)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Medusa</defName>
		<label>medusa scales</label>
		<description>Scales shed by a medusa. Cold, stone-pale, and oddly heavy.</description>
		<stuffProps><color>(140,145,140)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Wurm</defName>
		<label>wurm scales</label>
		<description>Scales shed by a wurm. Thick, blunt plates from a tunnelling body.</description>
		<stuffProps><color>(120,100,70)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Wyvern</defName>
		<label>wyvern scales</label>
		<description>Scales shed by a wyvern. Light and streamlined for the wing.</description>
		<stuffProps><color>(110,120,140)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_MalefDragon</defName>
		<label>malef dragon scales</label>
		<description>Scales shed by a malef dragon. Dark, lustrous, and faintly sinister.</description>
		<stuffProps><color>(80,60,90)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Dragonewt</defName>
		<label>dragonewt scales</label>
		<description>Scales shed by a dragonewt. Fresh-grown, softer than a true dragon's.</description>
		<stuffProps><color>(160,110,80)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Salamander</defName>
		<label>salamander scales</label>
		<description>Scales shed by a salamander. Ember-bright and heat-hardened.</description>
		<stuffProps><color>(190,90,40)</color></stuffProps>
	</ThingDef>

	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Bunyip</defName>
		<label>bunyip scales</label>
		<description>Scales shed by a bunyip. River-worn and dull green.</description>
		<stuffProps><color>(90,120,90)</color></stuffProps>
	</ThingDef>

</Defs>
