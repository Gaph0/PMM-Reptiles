<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Per-species scale materials (locked Q5): each reptile xenotype sheds its own
		scales. All reuse the single generic PMM_ReptileScale texture for now (later art
		pass); label, description, colour tint and stats differ per species.

		Stats (2026-09-06, user spreadsheet "leather chart.ods"). Interpretation:
		- armour sharp/blunt/heat columns are FACTORS on the LeatherBase values
		  sharp 0.81 and heat 1.5; the BLUNT factor applies to the SHARP base (0.81)
		  — every blunt factor ≤ its sharp factor, and f0.4 → 0.32 lands just under
		  thrumbofur (0.36) where premium scales belong (on the 0.24 blunt base
		  they'd be worse than dog leather, clearly not intended).
		- insulation columns are ABSOLUTE °C (StuffPower_Insulation is a °C offset;
		  as factors they'd give absurd 200-480°C values).
		- max HP and beauty are stuffProps statFACTORS (crafted-item multipliers,
		  the thrumbofur pattern); value is a factor on LeatherBase's $2.1.
		Species without a chart row share a listed species' stat line (user ruling):
		medusa/wurm → lamia, basilisk → lizard, wyvern → dragon,
		dragonewt → corrupt dragon.

		The abstract base carries only the neutral ResourceBase stats; every concrete
		material sets its full stat block explicitly so the factors stay readable
		next to the numbers they produced.
	-->

	<ThingDef Abstract="True" Name="PMM_ReptileScaleSpeciesBase" ParentName="ResourceBase">
		<thingCategories>
			<li>Leathers</li>
		</thingCategories>
		<stackLimit>75</stackLimit>
		<graphicData>
			<texPath>Things/Item/Resource/PMM_ReptileScale</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.03</Mass>
		</statBases>
		<stuffProps>
			<categories>
				<li>Leathery</li>
			</categories>
			<commonality>0.07</commonality>
			<color>(126,148,84)</color>
		</stuffProps>
	</ThingDef>

	<!-- Lizard scales (f1.3 sharp / f0.14 blunt / f0.2 heat / f1 cold / f0.9 heat-ins / f1.5 value).
		Also shed by basilisks (user ruling). -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Basilisk</defName>
		<label>basilisk scales</label>
		<description>Scales shed by a basilisk. Supple and keen-edged, workable like leather.</description>
		<statBases>
			<MarketValue>3.15</MarketValue>
			<StuffPower_Armor_Sharp>1.05</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.11</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>1.5</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>15</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>18</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps><color>(110,150,90)</color>
			<statFactors>
				<MaxHitPoints>1.3</MaxHitPoints>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Dragon scales (f2 HP/sharp, f0.4 blunt, f0.8 heat, f1.25 cold, f1.5 heat-ins,
		f6 beauty, f8 value) — the thrumbo-tier trophy leather. Also shed by wyverns. -->
	<ThingDef ParentName="PMM_ReptileScaleSpeciesBase">
		<defName>PMM_Scale_Dragon</defName>
		<label>dragon scales</label>
		<description>Scales shed by a dragon. Rich, hard, and faintly warm to the touch.</description>
		<statBases>
			<MarketValue>16.8</MarketValue>
			<StuffPower_Armor_Sharp>1.62</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.32</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>2.25</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>20</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>25</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps><color>(168,80,50)</color>
			<statFactors>
				<MaxHitPoints>2.0</MaxHitPoints>
				<Beauty>6</Beauty>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Lamia scales (f1 HP, f1 sharp, f0.14 blunt, f0.14 heat, f1 cold, f1.25 heat-ins,
