<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Dark Dragon's Blood: a vial of blackened blood drawn from a malef dragon.
		It works in two steps (IngestionOutcomeDoer_DarkDragonsBlood in the
		assembly), and one vial is used per step:

		  1. An ordinary woman drinks it and rises as a dragonewt.
		  2. A dragonewt drinks it and is blackened into a malef dragon. A normal
		     dragon skips straight to this step on her first vial.

		Between them these are the only way to create a malef outside the Broods
		roster; malefs, men, children and non-humans are unaffected - there is no
		step left for them. A drug, not a food - consumed deliberately, never for
		nutrition.

		Art: Textures/Things/Item/Resource/PMM_DarkDragonsBlood.png (64x64, RGBA with a
		transparent background - item textures need the alpha). The source file lives in
		the staging repo as Items/DarkDragonsBlood.png; re-export at 128x128 for a sharper
		icon, since 64x64 is half the usual size for an item.
	-->
	<ThingDef>
		<defName>PMM_DarkDragonsBlood</defName>
		<label>dark dragon's blood</label>
		<description>A stoppered vial of blood so dark it drinks the light, drawn from a malef dragon. It is warm to the touch, and it whispers.\n\nAn ordinary woman who drinks it is remade as a dragonewt - newly scaled, flushed, and hungry in a way she never asked for. A second vial blackens her into a malef dragon, her hunger deepening and her will bending to the dark queens' design; a normal dragon is blackened by her first. It does nothing for malef dragons, men, children, or beasts.</description>
		<thingClass>ThingWithComps</thingClass>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<resourceReadoutPriority>Middle</resourceReadoutPriority>
		<useHitPoints>true</useHitPoints>
		<selectable>true</selectable>
		<altitudeLayer>Item</altitudeLayer>
		<stackLimit>10</stackLimit>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<!-- Required: DrugPolicy.InitializeIfNeeded sorts all IsDrug defs by CompProperties_Drug.listOrder and NREs without it -->
			<li Class="CompProperties_Drug">
				<listOrder>1020</listOrder>
			</li>
		</comps>
		<alwaysHaulable>true</alwaysHaulable>
		<drawGUIOverlay>true</drawGUIOverlay>
		<rotatable>false</rotatable>
		<pathCost>14</pathCost>
		<graphicData>
			<texPath>Things/Item/Resource/PMM_DarkDragonsBlood</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<MarketValue>400</MarketValue>
			<Mass>0.05</Mass>
			<DeteriorationRate>0</DeteriorationRate>
			<Nutrition>0</Nutrition>
		</statBases>
		<ingestible>
			<foodType>Processed</foodType>
			<preferability>NeverForNutrition</preferability>
			<drugCategory>Medical</drugCategory>
			<nurseable>true</nurseable>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<outcomeDoers>
				<li Class="PMM_Reptiles.IngestionOutcomeDoer_DarkDragonsBlood"/>
			</outcomeDoers>
		</ingestible>
		<thingCategories>
			<li>Drugs</li>
		</thingCategories>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
	</ThingDef>

</Defs>
