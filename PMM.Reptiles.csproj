<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Project Momo\PMM.Shared.props" />

  <PropertyGroup>
    <AssemblyName>PMM_Reptiles</AssemblyName>
    <RootNamespace>PMM_Reptiles</RootNamespace>
  </PropertyGroup>

  <!-- All .cs under the project dir are compiled by SDK default (the only
       sources here are Source/Reptiles/*.cs, matching the old build.sh glob). -->

  <ItemGroup>
    <ProjectReference Include="..\Project Momo\ProjectMomo.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Reptiles-only reference: Vanilla Expanded Framework. -->
  <ItemGroup>
    <Reference Include="VEF">
      <HintPath>$(SteamModContentFolder)/2023507013/1.6/Assemblies/VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
